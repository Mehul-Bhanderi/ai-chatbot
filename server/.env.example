PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/ai-chatbot

# Auth
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRY=7d

# Which provider to use: openai | anthropic | ollama
LLM_PROVIDER=ollama

# Optional: override the provider's default model
LLM_MODEL=
LLM_MAX_TOKENS=2048

# Only needed for the provider you selected above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama runs locally and needs no key.
OLLAMA_HOST=http://localhost:11434
